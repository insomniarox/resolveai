# Copy this file to .env. Runtime inference uses exactly one server-side provider.
RESOLVEAI_RUNTIME_PROVIDER=openrouter
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Required for Compare models and optional Jev evaluations.
TYPESAFE_API_KEY=

# Generate a secret with `openssl rand -hex 32`; set it only on the API service.
RUNBOOK_ADMIN_TOKEN=
